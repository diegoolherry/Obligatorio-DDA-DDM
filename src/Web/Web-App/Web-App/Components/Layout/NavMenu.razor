@implements IDisposable
@inject ISesionCliente Sesion
@inject NavigationManager Navegacion
@using Web_App.Services.Authentication

<button type="button" class="menu-toggle btn btn-light" aria-expanded="@(_abierto ? "true" : "false")"
        aria-controls="menu-principal" @onclick="AlternarMenu" @onkeydown="AlTeclear">@(_abierto ? "Cerrar" : "Menú")</button>

<nav id="menu-principal" class="site-nav @(_abierto ? "abierto" : null)" aria-label="Principal" @onkeydown="AlTeclear">
    <ul class="nav-list">
        <li><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink></li>
        <li><NavLink class="nav-link" href="itinerarios">Buscar viaje</NavLink></li>
        <li><NavLink class="nav-link" href="horarios">Horarios</NavLink></li>
        @* Se muestran todos los enlaces, como antes del rediseño: ocultarlos no autoriza nada; la API comprueba cada permiso. *@
        <li><NavLink class="nav-link" href="pasajero/ubicacion">Ubicación del servicio</NavLink></li>
        <li><NavLink class="nav-link" href="admin/operativa">Administración operativa</NavLink></li>
    </ul>
    <div class="nav-session">
        @if (Autenticada)
        {
            <button type="button" class="btn btn-light" disabled="@_saliendo" @onclick="SalirAsync">@(_saliendo ? "Saliendo…" : "Salir")</button>
        }
        else
        {
            <a class="btn btn-primary" href="ingreso">Ingresar</a>
        }
    </div>
</nav>

@code {
    [Parameter] public bool Autenticada { get; set; }
    [Parameter] public EventCallback AlCambiarSesion { get; set; }

    private bool _abierto;
    private bool _saliendo;

    protected override void OnInitialized() => Navegacion.LocationChanged += AlNavegar;

    private void AlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _abierto = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void AlternarMenu() => _abierto = !_abierto;

    private void AlTeclear(KeyboardEventArgs tecla)
    {
        if (tecla.Code == "Escape") _abierto = false;
    }

    private async Task SalirAsync()
    {
        if (_saliendo) return;
        _saliendo = true;
        try { await Sesion.SalirAsync(); }
        finally { _saliendo = false; }
        _abierto = false;
        await AlCambiarSesion.InvokeAsync();
        // La página de ingreso muestra si la sesión quedó cerrada o si hay que reintentar el cierre.
        Navegacion.NavigateTo("ingreso");
    }

    public void Dispose() => Navegacion.LocationChanged -= AlNavegar;
}
