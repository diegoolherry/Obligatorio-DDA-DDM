@page "/admin/operativa"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Web_App.Models.Operational
@using Web_App.Services.Authentication
@using Web_App.Services.Operational
@inject ISesionCliente Sesion
@inject AdministracionOperativaCliente Cliente
@inject TimeProvider Reloj

<PageTitle>Administración operativa · Berrutti</PageTitle>
<div class="page-header">
    <h1>Paradas y tramos</h1>
    <p>Configuración operativa: paradas, tramos, servicios y tarifas.</p>
</div>
@if (!Sesion.Estado.Autenticada)
{
    <Alerta Tipo="TipoAviso.Advertencia" Titulo="Necesitás ingresar">
        Ingresá con la cuenta de administrador para continuar.
        <br /><a class="btn btn-primary" href="/ingreso">Ir al ingreso</a>
    </Alerta>
}
else if (!Autorizado)
{
    <Alerta Tipo="TipoAviso.Advertencia" Titulo="Acceso no confirmado">
        @Mensaje
        <br /><button type="button" class="btn btn-secondary" @onclick="ComprobarAccesoAsync" disabled="@Ocupado">Comprobar acceso</button>
    </Alerta>
}
else
{
    <Alerta Tipo="@(HayError ? TipoAviso.Error : TipoAviso.Info)">@Mensaje</Alerta>
    <section class="card mb-section" aria-labelledby="titulo-paradas">
        <h2 id="titulo-paradas">Paradas</h2>
        <EditForm Model="ParadaForm" OnValidSubmit="GuardarParadaAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="field">
                <label for="nombre-parada">Nombre</label>
                <InputText id="nombre-parada" @bind-Value="ParadaForm.Nombre" />
                <ValidationMessage For="() => ParadaForm.Nombre" />
            </div>
            <div class="cluster">
                <button class="btn btn-primary" disabled="@Ocupado">@(ParadaForm.Id == null ? "Crear parada" : "Guardar parada")</button>
                @if (ParadaForm.Id != null) { <button type="button" class="btn btn-secondary" @onclick="LimpiarParada">Cancelar edición</button> }
            </div>
        </EditForm>
        <ul class="list-plain list-rows">
            @foreach (var parada in Paradas)
            {
                <li class="row-actions"><span>@parada.Nombre</span>
                    <span><button type="button" class="btn btn-link" disabled="@Ocupado" @onclick="() => EditarParada(parada)">Editar</button>
                    <button type="button" class="btn btn-link btn-danger-text" disabled="@Ocupado" @onclick="() => SolicitarEliminarParada(parada)">Eliminar</button></span></li>
            }
        </ul>
    </section>
    <section class="card mb-section" aria-labelledby="titulo-tramos">
        <h2 id="titulo-tramos">Tramos</h2>
        <EditForm Model="TramoForm" OnValidSubmit="GuardarTramoAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="grid-form">
                <div class="field">
                    <label for="origen">Origen</label>
                    <InputSelect id="origen" @bind-Value="TramoForm.OrigenId"><option value="">Seleccioná una parada</option>@foreach (var p in Paradas) { <option value="@p.Id">@p.Nombre</option> }</InputSelect>
                    <ValidationMessage For="() => TramoForm.OrigenId" />
                </div>
                <div class="field">
                    <label for="destino">Destino</label>
                    <InputSelect id="destino" @bind-Value="TramoForm.DestinoId"><option value="">Seleccioná una parada</option>@foreach (var p in Paradas) { <option value="@p.Id">@p.Nombre</option> }</InputSelect>
                    <ValidationMessage For="() => TramoForm.DestinoId" />
                </div>
            </div>
            <div class="cluster">
                <button class="btn btn-primary" disabled="@Ocupado">@(TramoForm.Id == null ? "Crear tramo" : "Guardar tramo")</button>
                @if (TramoForm.Id != null) { <button type="button" class="btn btn-secondary" @onclick="LimpiarTramo">Cancelar edición</button> }
            </div>
        </EditForm>
        <ul class="list-plain list-rows">
            @foreach (var tramo in Tramos)
            {
                <li class="row-actions"><span>@tramo.OrigenNombre → @tramo.DestinoNombre</span>
                    <span><button type="button" class="btn btn-link" disabled="@Ocupado" @onclick="() => EditarTramo(tramo)">Editar</button>
                    <button type="button" class="btn btn-link btn-danger-text" disabled="@Ocupado" @onclick="() => SolicitarEliminarTramo(tramo)">Eliminar</button></span></li>
            }
        </ul>
    </section>
    <section class="card mb-section" aria-labelledby="titulo-servicios">
        <h2 id="titulo-servicios">Servicios</h2>
        <EditForm Model="ServicioForm" OnValidSubmit="GuardarServicioAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="grid-form">
                <div class="field">
                    <label for="servicio-tramo">Tramo</label>
                    <InputSelect id="servicio-tramo" @bind-Value="ServicioForm.TramoId">
                        <option value="">Seleccioná un tramo</option>
                        @foreach (var tramo in Tramos) { <option value="@tramo.Id">@tramo.OrigenNombre → @tramo.DestinoNombre</option> }
                    </InputSelect>
                    <ValidationMessage For="() => ServicioForm.TramoId" />
                </div>
                <div class="field">
                    <label for="servicio-politica">Política de asiento</label>
                    <InputSelect id="servicio-politica" @bind-Value="ServicioForm.PoliticaAsiento">
                        <option value="@PoliticaAsiento.SinAsiento">Sin asiento</option>
                        <option value="@PoliticaAsiento.AsignacionAutomatica">Asignación automática</option>
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="servicio-salida">Salida</label>
                    <InputDate id="servicio-salida" Type="InputDateType.DateTimeLocal" @bind-Value="ServicioForm.Salida" />
                    <ValidationMessage For="() => ServicioForm.Salida" />
                </div>
                <div class="field">
                    <label for="servicio-llegada">Llegada</label>
                    <InputDate id="servicio-llegada" Type="InputDateType.DateTimeLocal" @bind-Value="ServicioForm.Llegada" />
                    <ValidationMessage For="() => ServicioForm.Llegada" />
                </div>
                <div class="field">
                    <label for="servicio-capacidad">Capacidad</label>
                    <InputNumber id="servicio-capacidad" @bind-Value="ServicioForm.Capacidad" />
                    <ValidationMessage For="() => ServicioForm.Capacidad" />
                </div>
            </div>
            <div class="cluster">
                <button class="btn btn-primary" disabled="@Ocupado">@(ServicioForm.Id == null ? "Crear servicio" : "Guardar servicio")</button>
                @if (ServicioForm.Id != null) { <button type="button" class="btn btn-secondary" @onclick="LimpiarServicio">Cancelar edición</button> }
            </div>
        </EditForm>
        <div class="field">
            <label for="servicios-fecha">Fecha</label>
            <input id="servicios-fecha" type="date" value="@FechaServicios.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   @onchange="CambiarFechaServiciosAsync" disabled="@(Ocupado || CargandoServicios)" />
        </div>
        @if (CargandoServicios)
        {
            <p role="status">Cargando servicios…</p>
        }
        else if (ErrorServicios != null)
        {
            <Alerta Tipo="TipoAviso.Error">
                @ErrorServicios
                <br /><button type="button" class="btn btn-secondary" disabled="@Ocupado" @onclick="CargarServiciosAsync">Reintentar</button>
            </Alerta>
        }
        else if (Servicios.Count == 0)
        {
            <Alerta>No hay servicios el @FechaServicios.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture).</Alerta>
        }
        else
        {
        <ul class="list-plain list-rows">
            @foreach (var servicio in Servicios)
            {
                var tramo = Tramos.FirstOrDefault(t => t.Id == servicio.TramoId);
                <li class="row-actions">
                    <span>
                        @(tramo == null ? "Tramo no disponible" : $"{tramo.OrigenNombre} → {tramo.DestinoNombre}") ·
                        Salida @servicio.Salida.ToString("yyyy-MM-dd HH:mm") – Llegada @servicio.Llegada.ToString("yyyy-MM-dd HH:mm"),
                        capacidad @servicio.Capacidad, @EtiquetaPolitica(servicio.PoliticaAsiento)
                    </span>
                    <span>
                        <button type="button" class="btn btn-link" disabled="@Ocupado" @onclick="() => EditarServicio(servicio)">Editar</button>
                        <button type="button" class="btn btn-link btn-danger-text" disabled="@Ocupado" @onclick="() => SolicitarEliminarServicio(servicio)">Eliminar</button>
                    </span>
                </li>
            }
        </ul>
        }
    </section>
    <section class="card mb-section" aria-labelledby="titulo-tarifas">
        <h2 id="titulo-tarifas">Tarifas</h2>
        <EditForm Model="TarifaForm" OnValidSubmit="GuardarTarifaAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="grid-form">
                <div class="field">
                    <label for="tarifa-tramo">Tramo</label>
                    <InputSelect id="tarifa-tramo" @bind-Value="TarifaForm.TramoId">
                        <option value="">Seleccioná un tramo</option>
                        @foreach (var tramo in Tramos) { <option value="@tramo.Id">@tramo.OrigenNombre → @tramo.DestinoNombre</option> }
                    </InputSelect>
                    <ValidationMessage For="() => TarifaForm.TramoId" />
                </div>
                <div class="field">
                    <label for="tarifa-importe">Importe</label>
                    <InputNumber id="tarifa-importe" min="0" step="0.01" @bind-Value="TarifaForm.Importe" />
                    <ValidationMessage For="() => TarifaForm.Importe" />
                </div>
                <div class="field">
                    <label for="tarifa-desde">Vigente desde</label>
                    <InputDate id="tarifa-desde" @bind-Value="TarifaForm.VigenteDesde" />
                    <ValidationMessage For="() => TarifaForm.VigenteDesde" />
                </div>
                <div class="field">
                    <label for="tarifa-hasta">Vigente hasta</label>
                    <InputDate id="tarifa-hasta" @bind-Value="TarifaForm.VigenteHasta" />
                    <ValidationMessage For="() => TarifaForm.VigenteHasta" />
                </div>
            </div>
            <div class="cluster">
                <button class="btn btn-primary" disabled="@Ocupado">@(TarifaForm.Id == null ? "Crear tarifa" : "Guardar tarifa")</button>
                @if (TarifaForm.Id != null) { <button type="button" class="btn btn-secondary" @onclick="LimpiarTarifa">Cancelar edición</button> }
            </div>
        </EditForm>
        <ul class="list-plain list-rows">
            @foreach (var tarifa in Tarifas)
            {
                var tramo = Tramos.FirstOrDefault(t => t.Id == tarifa.TramoId);
                <li class="row-actions">
                    <span>
                        @(tramo == null ? "Tramo no disponible" : $"{tramo.OrigenNombre} → {tramo.DestinoNombre}") ·
                        @tarifa.Importe.ToString("0.00") (vigente @tarifa.VigenteDesde.ToString("yyyy-MM-dd") a @tarifa.VigenteHasta.ToString("yyyy-MM-dd"))
                    </span>
                    <span>
                        <button type="button" class="btn btn-link" disabled="@Ocupado" @onclick="() => EditarTarifa(tarifa)">Editar</button>
                        <button type="button" class="btn btn-link btn-danger-text" disabled="@Ocupado" @onclick="() => SolicitarEliminarTarifa(tarifa)">Eliminar</button>
                    </span>
                </li>
            }
        </ul>
    </section>
    @if (_eliminacionPendiente is { } pendiente)
    {
        <Alerta Tipo="TipoAviso.Advertencia" Titulo="Eliminar pendiente" aria-label="Confirmar eliminación" aria-busy="@Ocupado.ToString().ToLowerInvariant()">
            <p>¿Confirmás eliminar la @pendiente.Nombre seleccionada?</p>
            <div class="cluster">
                <button type="button" class="btn btn-danger" disabled="@Ocupado" @onclick="ConfirmarEliminarAsync">Confirmar</button>
                <button type="button" class="btn btn-secondary" disabled="@Ocupado" @onclick="CancelarEliminar">Cancelar</button>
            </div>
        </Alerta>
    }
}

@code {
    private readonly FormularioParada ParadaForm = new();
    private readonly FormularioTramo TramoForm = new();
    private readonly FormularioServicio ServicioForm = new();
    private readonly FormularioTarifa TarifaForm = new();
    private List<ParadaDto> Paradas = [];
    private List<TramoDto> Tramos = [];
    private List<ServicioDto> Servicios = [];
    private List<TarifaDto> Tarifas = [];
    private bool Autorizado, Ocupado, HayError, CargandoServicios;
    private DateOnly FechaServicios;
    private string? ErrorServicios;
    private string Mensaje = "Verificando tus permisos…";

    protected override async Task OnInitializedAsync()
    {
        FechaServicios = DateOnly.FromDateTime(Reloj.GetLocalNow().DateTime);
        await ComprobarAccesoAsync();
    }
    private async Task ComprobarAccesoAsync()
    {
        if (!Sesion.Estado.Autenticada) { Mensaje = "Ingresá con una sesión activa."; return; }
        Ocupado = true;
        var acceso = await Sesion.ProbarAdministradorAsync();
        Autorizado = acceso.Exito;
        Mensaje = acceso.Mensaje;
        Ocupado = false;
        if (Autorizado) await RecargarAsync();
    }
    private void Informar(string? error, string exito) { HayError = error != null; Mensaje = error ?? exito; }
    private async Task RecargarAsync()
    {
        var paradas = await Cliente.ListarParadasAsync();
        var tramos = await Cliente.ListarTramosAsync();
        var tarifas = await Cliente.ListarTarifasAsync();
        Paradas = paradas.Items.ToList(); Tramos = tramos.Items.ToList(); Tarifas = tarifas.Items.ToList();
        await CargarServiciosAsync();
        Informar(paradas.Error ?? tramos.Error ?? tarifas.Error, "Datos actualizados.");
    }
    // Los servicios se piden de a un día: el listado completo (miles de filas) bloquea el navegador.
    private async Task CargarServiciosAsync()
    {
        CargandoServicios = true; ErrorServicios = null;
        var servicios = await Cliente.ListarServiciosAsync(FechaServicios);
        Servicios = servicios.Items.ToList(); ErrorServicios = servicios.Error;
        CargandoServicios = false;
    }
    private async Task CambiarFechaServiciosAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value as string, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
        { Servicios = []; ErrorServicios = "Elegí una fecha para ver los servicios."; return; }
        FechaServicios = fecha;
        await CargarServiciosAsync();
    }
    private async Task GuardarParadaAsync()
    {
        Ocupado = true;
        var error = await Cliente.GuardarParadaAsync(new() { Id = ParadaForm.Id, Nombre = ParadaForm.Nombre });
        if (error == null) { ParadaForm.Id = null; ParadaForm.Nombre = string.Empty; }
        await RecargarAsync(); Informar(error, "Parada guardada."); Ocupado = false;
    }
    private async Task GuardarTramoAsync()
    {
        Ocupado = true;
        var error = await Cliente.GuardarTramoAsync(new() { Id = TramoForm.Id, OrigenId = TramoForm.OrigenId, DestinoId = TramoForm.DestinoId });
        if (error == null) LimpiarTramo();
        await RecargarAsync(); Informar(error, "Tramo guardado."); Ocupado = false;
    }
    private void EditarParada(ParadaDto p) { ParadaForm.Id = p.Id; ParadaForm.Nombre = p.Nombre; }
    private void EditarTramo(TramoDto t) { TramoForm.Id = t.Id; TramoForm.OrigenId = t.OrigenId; TramoForm.DestinoId = t.DestinoId; }
    private void LimpiarParada() { ParadaForm.Id = null; ParadaForm.Nombre = string.Empty; }
    private void LimpiarTramo() { TramoForm.Id = null; TramoForm.OrigenId = TramoForm.DestinoId = string.Empty; }
    private async Task GuardarServicioAsync()
    {
        if (ServicioForm.Llegada <= ServicioForm.Salida)
        { Mensaje = "La llegada debe ser posterior a la salida."; HayError = true; return; }
        Ocupado = true;
        var salidaGuardada = ServicioForm.Salida!.Value;
        var error = await Cliente.GuardarServicioAsync(new() { Id = ServicioForm.Id, TramoId = ServicioForm.TramoId,
            Salida = salidaGuardada, Llegada = ServicioForm.Llegada!.Value,
            Capacidad = ServicioForm.Capacidad, PoliticaAsiento = ServicioForm.PoliticaAsiento });
        if (error == null) { LimpiarServicio(); FechaServicios = DateOnly.FromDateTime(salidaGuardada); }
        await RecargarAsync(); Informar(error, "Servicio guardado."); Ocupado = false;
    }
    private void EditarServicio(ServicioDto servicio)
    {
        ServicioForm.Id = servicio.Id; ServicioForm.TramoId = servicio.TramoId; ServicioForm.Salida = servicio.Salida;
        ServicioForm.Llegada = servicio.Llegada;
        ServicioForm.Capacidad = servicio.Capacidad; ServicioForm.PoliticaAsiento = servicio.PoliticaAsiento;
    }
    private void LimpiarServicio()
    {
        ServicioForm.Id = null; ServicioForm.TramoId = string.Empty; ServicioForm.Salida = ServicioForm.Llegada = null; ServicioForm.Capacidad = 1;
        ServicioForm.PoliticaAsiento = PoliticaAsiento.SinAsiento;
    }
    private async Task GuardarTarifaAsync()
    {
        Ocupado = true;
        var error = await Cliente.GuardarTarifaAsync(new() { Id = TarifaForm.Id, TramoId = TarifaForm.TramoId,
            Importe = TarifaForm.Importe, VigenteDesde = TarifaForm.VigenteDesde!.Value.Date,
            VigenteHasta = TarifaForm.VigenteHasta!.Value.Date });
        if (error == null) LimpiarTarifa();
        await RecargarAsync(); Informar(error, "Tarifa guardada."); Ocupado = false;
    }
    private void EditarTarifa(TarifaDto tarifa)
    {
        TarifaForm.Id = tarifa.Id; TarifaForm.TramoId = tarifa.TramoId; TarifaForm.Importe = tarifa.Importe;
        TarifaForm.VigenteDesde = tarifa.VigenteDesde; TarifaForm.VigenteHasta = tarifa.VigenteHasta;
    }
    private void LimpiarTarifa()
    {
        TarifaForm.Id = null; TarifaForm.TramoId = string.Empty; TarifaForm.Importe = 0;
        TarifaForm.VigenteDesde = null; TarifaForm.VigenteHasta = null;
    }
    private (string Tipo, string Id, string Nombre)? _eliminacionPendiente;
    private void SolicitarEliminarParada(ParadaDto p) => SolicitarEliminar("paradas", p.Id, "parada");
    private void SolicitarEliminarTramo(TramoDto t) => SolicitarEliminar("tramos", t.Id, "tramo");
    private void SolicitarEliminarServicio(ServicioDto s) => SolicitarEliminar("servicios", s.Id, "servicio");
    private void SolicitarEliminarTarifa(TarifaDto t) => SolicitarEliminar("tarifas", t.Id, "tarifa");
    private void SolicitarEliminar(string tipo, string? id, string nombre)
    {
        if (Ocupado || id == null) return;
        _eliminacionPendiente = (tipo, id, nombre);
    }
    private void CancelarEliminar()
    {
        if (!Ocupado) _eliminacionPendiente = null;
    }
    private async Task ConfirmarEliminarAsync()
    {
        if (Ocupado || _eliminacionPendiente is not { } pending) return;
        Ocupado = true;
        try
        {
            var error = await Cliente.EliminarAsync(pending.Tipo, pending.Id);
            await RecargarAsync(); Informar(error, $"{pending.Nombre} eliminado.");
            _eliminacionPendiente = null;
        }
        finally { Ocupado = false; }
    }
    private sealed class FormularioParada { public string? Id { get; set; } [Required(ErrorMessage = "Ingresá el nombre de la parada."), StringLength(100, MinimumLength = 1, ErrorMessage = "El nombre no puede superar los 100 caracteres.")] public string Nombre { get; set; } = string.Empty; }
    private sealed class FormularioTramo { public string? Id { get; set; } [Required(ErrorMessage = "Elegí el origen.")] public string OrigenId { get; set; } = string.Empty; [Required(ErrorMessage = "Elegí el destino.")] public string DestinoId { get; set; } = string.Empty; }
    private static string EtiquetaPolitica(PoliticaAsiento politica) => politica == PoliticaAsiento.SinAsiento ? "Sin asiento" : "Asignación automática";
    private sealed class FormularioServicio
    {
        public string? Id { get; set; }
        [Required(ErrorMessage = "Elegí el tramo.")] public string TramoId { get; set; } = string.Empty;
        [Required(ErrorMessage = "Ingresá la fecha y hora de salida.")] public DateTime? Salida { get; set; }
        [Required(ErrorMessage = "Ingresá la fecha y hora de llegada.")] public DateTime? Llegada { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "La capacidad debe ser al menos 1.")] public int Capacidad { get; set; } = 1;
        public PoliticaAsiento PoliticaAsiento { get; set; }
    }
    private sealed class FormularioTarifa
    {
        public string? Id { get; set; }
        [Required(ErrorMessage = "Elegí el tramo.")] public string TramoId { get; set; } = string.Empty;
        [Range(typeof(decimal), "0", "9999999999999999.99", ParseLimitsInInvariantCulture = true, ErrorMessage = "Ingresá un importe válido, de 0 o más.")] public decimal Importe { get; set; }
        [Required(ErrorMessage = "Ingresá la fecha de inicio de vigencia.")] public DateTime? VigenteDesde { get; set; }
        [Required(ErrorMessage = "Ingresá la fecha de fin de vigencia.")] public DateTime? VigenteHasta { get; set; }
    }
}
