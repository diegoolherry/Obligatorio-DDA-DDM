@page "/ingreso"
@using Web_App.Models.Authentication
@using Web_App.Services.Authentication
@inject ISesionCliente Sesion

<PageTitle>Ingresar · Berrutti</PageTitle>

<div class="split split-login">
    <div>
        <h1>Ingresar</h1>
        <p class="lead">Con tu cuenta podés consultar la ubicación de un servicio. Los administradores acceden además a la administración operativa.</p>
        <Alerta Tipo="TipoAviso.Info">La sesión se mantiene solo mientras esta pestaña está abierta. Si recargás la página, tenés que ingresar de nuevo.</Alerta>
    </div>

    <Tarjeta aria-busy="@Ocupada.ToString().ToLowerInvariant()">
        @if (Sesion.Estado.Autenticada)
        {
            <h2 class="h3">Sesión iniciada</h2>
            @if (_mensaje != null)
            {
                <Alerta Tipo="_tipo" id="estado-ingreso">@_mensaje</Alerta>
            }
            <p>Los permisos se comprueban en la API cada vez que consultás un dato protegido.</p>
            <div class="cluster">
                <button type="button" class="btn btn-primary" disabled="@Ocupada" @onclick="SalirAsync">@(Ocupada ? "Procesando…" : "Cerrar sesión")</button>
                <button type="button" class="btn btn-secondary" disabled="@Ocupada" @onclick="ProbarAdministradorAsync">Comprobar acceso de administrador</button>
            </div>
        }
        else
        {
            <h2 class="h3">Datos de tu cuenta</h2>
            @if (_mensaje != null)
            {
                <Alerta Tipo="_tipo" Titulo="@(_tipo == TipoAviso.Error ? "No pudimos ingresar" : null)" id="estado-ingreso">@_mensaje</Alerta>
            }
            <EditForm Model="_solicitud" OnValidSubmit="IngresarAsync" FormName="ingreso">
                <DataAnnotationsValidator />
                <ResumenValidacion />
                <fieldset disabled="@Ocupada">
                    <div class="field">
                        <label for="correo">Correo</label>
                        <InputText id="correo" type="email" class="@(Rechazado ? "campo-rechazado" : null)" autocomplete="off"
                                   aria-describedby="@(Rechazado ? "estado-ingreso" : null)" @bind-Value="_solicitud.Correo" />
                        <ValidationMessage For="() => _solicitud.Correo" />
                    </div>
                    <div class="field">
                        <label for="contrasena">Contraseña</label>
                        <InputText id="contrasena" type="password" class="@(Rechazado ? "campo-rechazado" : null)" autocomplete="off"
                                   aria-describedby="@(Rechazado ? "estado-ingreso" : null)" @bind-Value="_solicitud.Contrasena" />
                        <ValidationMessage For="() => _solicitud.Contrasena" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block">@(Ocupada ? "Ingresando…" : "Ingresar")</button>
                </fieldset>
                <p class="field-hint mb-hint">Conservamos tu correo; la contraseña se borra por seguridad.</p>
            </EditForm>
        }
    </Tarjeta>
</div>

@code {
    [CascadingParameter] private MainLayout? Layout { get; set; }

    private SolicitudIngresoDto _solicitud = new();
    private string? _mensaje;
    private TipoAviso _tipo = TipoAviso.Info;
    private bool _enviando;
    private bool Ocupada => _enviando || Sesion.Estado.Ocupada;
    private bool Rechazado => _mensaje != null && _tipo == TipoAviso.Error;

    private async Task IngresarAsync()
    {
        if (Ocupada) return;
        _enviando = true;
        Informar("Verificando tus datos…", TipoAviso.Info);
        var envio = new SolicitudIngresoDto { Correo = _solicitud.Correo, Contrasena = _solicitud.Contrasena };
        _solicitud = new SolicitudIngresoDto { Correo = _solicitud.Correo };
        try { Informar(await Sesion.IngresarAsync(envio)); }
        finally { envio.Contrasena = string.Empty; _enviando = false; Layout?.Actualizar(); }
    }

    private async Task ProbarAdministradorAsync()
    {
        if (Ocupada) return;
        _enviando = true;
        Informar("Consultando permiso en la API…", TipoAviso.Info);
        try { Informar(await Sesion.ProbarAdministradorAsync()); }
        finally { _enviando = false; Layout?.Actualizar(); }
    }

    private async Task SalirAsync()
    {
        if (Ocupada) return;
        _enviando = true;
        Informar("Cerrando la sesión…", TipoAviso.Info);
        try { Informar(await Sesion.SalirAsync()); }
        finally { _enviando = false; Layout?.Actualizar(); }
    }

    private void Informar(string mensaje, TipoAviso tipo) { _mensaje = mensaje; _tipo = tipo; }
    private void Informar(ResultadoAutenticacion resultado) => Informar(resultado.Mensaje, resultado.Exito ? TipoAviso.Exito : TipoAviso.Error);
}
